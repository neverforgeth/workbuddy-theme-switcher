    "workbuddy": {
      "css": "/* ==========================================================================\n   WorkBuddy Ice Blue · 粉色性能安全主题\n   Target : Tencent WorkBuddy 5.2.6 (renderer-only theming)\n   Scope  : html.codedrobe-host-workbuddy\n   来源   : workbuddy-home-dom.json / workbuddy-chat-dom.json (2026-07-22)\n   原则   : 稳定语义选择器优先，哈希 class 仅作辅助；不改布局与点击区域；\n            阅读清晰度优先；无远程资源；无脚本；克制使用 !important。\n   ========================================================================== */\n\n/* --------------------------------------------------------------------------\n   1. Design Tokens\n   -------------------------------------------------------------------------- */\n/* ==============================\n   WorkBuddy Theme Tokens\n   修改本区域即可统一切换主题色\n   ============================== */\n:root.codedrobe-host-workbuddy {\n  /* RGB tokens keep every existing rgba() alpha value exact. */\n  /* Background and hero */\n  --wb-theme-background-start-rgb: 214 238 252;\n  --wb-theme-background-middle-rgb: 196 228 247;\n  --wb-theme-background-end-rgb: 168 210 238;\n  --wb-theme-hero-glow-primary-rgb: 150 205 242;\n  --wb-theme-hero-glow-secondary-rgb: 218 240 252;\n  --wb-theme-overlay-cool-rgb: 240 249 253;\n  --wb-theme-overlay-mist-rgb: 232 244 251;\n  --wb-theme-overlay-light-rgb: 246 251 255;\n\n  /* Surfaces: base, sidebar, cards, and interaction layers */\n  --wb-theme-white-rgb: 255 255 255;\n  --wb-theme-surface-rgb: 245 251 255;\n  --wb-theme-surface-strong-rgb: 250 253 255;\n  --wb-theme-surface-solid-rgb: 252 254 255;\n  --wb-theme-surface-chat-rgb: 242 250 255;\n  --wb-theme-surface-composer-rgb: 238 247 253;\n  --wb-theme-sidebar-rgb: 229 243 252;\n  --wb-theme-selection-rgb: 205 231 246;\n  --wb-theme-user-message-rgb: 198 227 245;\n  --wb-theme-card-soft-rgb: 219 238 249;\n  --wb-theme-surface-weak-rgb: 228 244 252;\n  --wb-theme-surface-page-rgb: 236 246 252;\n  --wb-theme-surface-card-rgb: 226 241 250;\n  --wb-theme-surface-raised-rgb: 216 236 248;\n  --wb-theme-surface-hover-rgb: 205 230 245;\n  --wb-theme-surface-emphasis-rgb: 176 214 238;\n  --wb-theme-surface-subtle-rgb: 222 240 249;\n  --wb-theme-surface-tint-rgb: 210 233 246;\n  --wb-theme-surface-input-rgb: 243 250 254;\n  --wb-theme-surface-menu-rgb: 231 244 251;\n\n  /* Accent, borders, shadow, and text */\n  --wb-theme-accent-rgb: 74 155 216;\n  --wb-theme-accent-strong-rgb: 43 117 178;\n  --wb-theme-accent-active-rgb: 232 131 107;\n  --wb-theme-border-rgb: 150 196 226;\n  --wb-theme-shadow-muted-rgb: 62 106 138;\n  --wb-theme-hero-highlight-rgb: 255 253 245;\n  --wb-theme-text-primary-rgb: 39 71 95;\n  --wb-theme-text-heading-rgb: 30 58 82;\n  --wb-theme-text-secondary-rgb: 104 135 155;\n  --wb-theme-text-muted-rgb: 137 163 179;\n\n  /* Homepage layers: keep the hero artwork visible without reducing input\n     readability. These values are intentionally limited to the home route. */\n  --wb-theme-home-panel-alpha: .55;\n  --wb-theme-home-input-alpha: .10;\n  --wb-theme-home-footer-alpha: .10;\n  --wb-theme-home-footer-control-alpha: .30;\n  --wb-theme-home-border-alpha: .22;\n  --wb-theme-home-focus-alpha: .16;\n  --wb-theme-home-highlight-alpha: .40;\n  --wb-theme-send-deep-rgb: 34 100 152;\n}\n\n:root.codedrobe-host-workbuddy {\n  color-scheme: light !important;\n\n  /* 页面背景 */\n  --cg-bg-start: rgb(var(--wb-theme-background-start-rgb));\n  --cg-bg-end: rgb(var(--wb-theme-background-end-rgb));\n  --cg-glow-1: rgb(var(--wb-theme-hero-glow-primary-rgb) / .50);\n  --cg-glow-2: rgb(var(--wb-theme-hero-glow-secondary-rgb) / .45);\n\n  /* 三档玻璃表面 */\n  --cg-glass: rgb(var(--wb-theme-surface-rgb) / .72);\n  --cg-glass-strong: rgb(var(--wb-theme-surface-strong-rgb) / .94);\n  --cg-solid: rgb(var(--wb-theme-surface-solid-rgb) / .98);\n\n  /* 描边 */\n  --cg-border: rgb(var(--wb-theme-border-rgb) / .28);\n  --cg-border-strong: rgb(var(--wb-theme-accent-rgb) / .45);\n\n  /* 文字 */\n  --cg-text: rgb(var(--wb-theme-text-primary-rgb));\n  --cg-text-muted: rgb(var(--wb-theme-text-muted-rgb));\n\n  /* 品牌蓝 */\n  --cg-brand: rgb(var(--wb-theme-accent-rgb));\n  --cg-brand-deep: rgb(var(--wb-theme-accent-strong-rgb));\n  --cg-brand-soft: rgb(var(--wb-theme-accent-rgb) / .12);\n\n  /* 聚焦光晕 */\n  --cg-focus-ring: rgb(var(--wb-theme-accent-rgb) / .22);\n\n  /* 阴影 */\n  --cg-shadow-panel: 0 16px 36px -14px rgb(var(--wb-theme-accent-strong-rgb) / .25);\n  --cg-shadow-pop: 0 12px 30px -10px rgb(var(--wb-theme-accent-strong-rgb) / .28);\n  --cg-shadow-soft: 0 6px 16px -8px rgb(var(--wb-theme-accent-strong-rgb) / .16);\n\n  /* 圆角 */\n  --cg-radius-lg: 18px;\n  --cg-radius-md: 14px;\n  --cg-radius-sm: 10px;\n\n  /* 顶部高光（玻璃边缘） */\n  --cg-edge-light: inset 0 1px 0 rgb(var(--wb-theme-white-rgb) / .85);\n\n  /* Packaged local hero asset: strong only on the welcome page. */\n  --pc-home-hero-overlay: rgb(var(--wb-theme-overlay-cool-rgb) / .54);\n  --pc-page-hero-overlay: rgb(var(--wb-theme-overlay-mist-rgb) / .93);\n}\n\n/* --------------------------------------------------------------------------\n   2. 页面背景：银白冰蓝渐变 + 静态光斑 + 冰晶纹理\n   -------------------------------------------------------------------------- */\nhtml.codedrobe-host-workbuddy,\nhtml.codedrobe-host-workbuddy body,\nhtml.codedrobe-host-workbuddy #root,\nhtml.codedrobe-host-workbuddy .teams-container {\n  background-color: var(--cg-bg-end) !important;\n  background-image:\n    radial-gradient(52% 42% at 84% -4%, var(--cg-glow-1), transparent 70%),\n    radial-gradient(46% 38% at 6% 106%, var(--cg-glow-2), transparent 70%),\n    linear-gradient(160deg, var(--cg-bg-start) 0%, rgb(var(--wb-theme-background-middle-rgb)) 52%, var(--cg-bg-end) 100%) !important;\n  background-repeat: no-repeat !important;\n  background-size: auto !important;\n  color: var(--cg-text) !important;\n}\n\n/* 工作区各层保持透明，让背景透上来 */\nhtml.codedrobe-host-workbuddy :is(.teams-content-wrapper, .teams-main-content, .main-content) {\n  background: transparent !important;\n  color: var(--cg-text) !important;\n}\n\n/* WorkBuddy 5.2.6 wraps the sidebar/workspace in CSS Modules grid cells.\n   Keep these shells transparent so the crystal background can show through. */\nhtml.codedrobe-host-workbuddy #workbuddy-menubar-container,\nhtml.codedrobe-host-workbuddy .workbuddy-window-controls,\nhtml.codedrobe-host-workbuddy .teams-container [class*='_gridViewItem_'] {\n  background: transparent !important;\n}\n\nhtml.codedrobe-host-workbuddy #workbuddy-menubar-container {\n  border-bottom: 1px solid var(--cg-border) !important;\n}\n\n/* --------------------------------------------------------------------------\n   3. 左侧栏：磨砂玻璃 + 冰蓝分隔\n   -------------------------------------------------------------------------- */\nhtml.codedrobe-host-workbuddy .conversation-sidebar {\n  /* 比通用玻璃略冷、略实，和主区拉开层次 */\n  background: rgb(var(--wb-theme-sidebar-rgb) / .78) !important;\n  border-right: 1px solid var(--cg-border) !important;\n  box-shadow: var(--cg-edge-light);\n  color: var(--cg-text) !important;\n}\n\nhtml.codedrobe-host-workbuddy .conversation-list {\n  background: transparent !important;\n  color: var(--cg-text) !important;\n}\n\n/* 侧栏顶部操作钮 / 标签页 */\nhtml.codedrobe-host-workbuddy .conversation-sidebar :is(button, [role='button'], a) {\n  color: var(--cg-text) !important;\n  border-radius: var(--cg-radius-sm);\n  transition: background-color .15s ease, box-shadow .15s ease;\n}\n\nhtml.codedrobe-host-workbuddy .conversation-sidebar :is(button, [role='button'], a):hover {\n  background: rgb(var(--wb-theme-white-rgb) / .55) !important;\n}\n\nhtml.codedrobe-host-workbuddy .conversation-list-tab-button.active,\nhtml.codedrobe-host-workbuddy .conversation-list-tab-button[aria-selected='true'] {\n  background: var(--cg-brand-soft) !important;\n  color: var(--cg-brand-deep) !important;\n  box-shadow: inset 0 0 0 1px var(--cg-border);\n}\n\n/* 分组小节标题 */\nhtml.codedrobe-host-workbuddy :is(.conversation-section-label, .collapsible-section-label) {\n  color: var(--cg-text-muted) !important;\n}\n\n/* 会话卡片 */\nhtml.codedrobe-host-workbuddy .conversation-agent-card {\n  border: 1px solid transparent !important;\n  border-radius: var(--cg-radius-md) !important;\n  background: transparent !important;\n  color: var(--cg-text) !important;\n  transition: background-color .15s ease, box-shadow .15s ease;\n}\n\nhtml.codedrobe-host-workbuddy .conversation-agent-card:hover {\n  background: rgb(var(--wb-theme-white-rgb) / .60) !important;\n  box-shadow: var(--cg-edge-light), var(--cg-shadow-soft);\n}\n\n/* 选中会话：浅蓝玻璃 + 左侧品牌蓝指示条（inset 实现，不占布局）。\n   注：_selected_ 为 CSS Modules 哈希命名，仅作辅助（见 selector-map.md §2）。 */\nhtml.codedrobe-host-workbuddy .conversation-agent-card[class*='_selected_'],\nhtml.codedrobe-host-workbuddy .conversation-agent-card.active,\nhtml.codedrobe-host-workbuddy .conversation-agent-card[aria-current='page'] {\n  background: rgb(var(--wb-theme-selection-rgb) / .85) !important;\n  border-color: var(--cg-border) !important;\n  box-shadow: inset 3px 0 0 var(--cg-brand), var(--cg-edge-light);\n  color: var(--cg-text) !important;\n}\n\n/* 侧栏底部用户区 */\nhtml.codedrobe-host-workbuddy .conversation-list-footer {\n  border-top: 1px solid var(--cg-border) !important;\n  background: rgb(var(--wb-theme-white-rgb) / .35) !important;\n}\n\nhtml.codedrobe-host-workbuddy .user-menu-trigger:hover {\n  background: rgb(var(--wb-theme-white-rgb) / .6) !important;\n}\n\n/* --------------------------------------------------------------------------\n   4. 顶栏 / 菜单栏 / 窗口控制\n   -------------------------------------------------------------------------- */\nhtml.codedrobe-host-workbuddy .codebuddy-menubar {\n  background: transparent !important;\n  color: var(--cg-text) !important;\n}\n\nhtml.codedrobe-host-workbuddy .menubar-menu-button:hover {\n  background: rgb(var(--wb-theme-white-rgb) / .55) !important;\n}\n\nhtml.codedrobe-host-workbuddy .workbuddy-topbar {\n  background: transparent !important;\n  color: var(--cg-text) !important;\n  border-bottom: 1px solid var(--cg-border) !important;\n}\n\nhtml.codedrobe-host-workbuddy .workbuddy-topbar-title {\n  color: var(--cg-text) !important;\n}\n\nhtml.codedrobe-host-workbuddy .workbuddy-window-control-button {\n  color: var(--cg-text-muted) !important;\n}\n\nhtml.codedrobe-host-workbuddy .workbuddy-window-control-button:hover {\n  background: rgb(var(--wb-theme-white-rgb) / .6) !important;\n  color: var(--cg-text) !important;\n}\n\nhtml.codedrobe-host-workbuddy .workbuddy-window-control-button.close:hover {\n  background: rgb(var(--wb-theme-accent-active-rgb) / .88) !important;\n  color: rgb(var(--wb-theme-white-rgb)) !important;\n}\n\n/* --------------------------------------------------------------------------\n   5. 首页：标题区 / 场景标签 / 快捷操作\n   -------------------------------------------------------------------------- */\nhtml.codedrobe-host-workbuddy .wb-home-header {\n  background: transparent !important;\n  border: none !important;\n  box-shadow: none !important;\n}\n\nhtml.codedrobe-host-workbuddy .wb-home-header__title {\n  color: var(--cg-text) !important;\n  letter-spacing: .01em;\n}\n\nhtml.codedrobe-host-workbuddy .wb-home-header__subtitle {\n  color: var(--cg-text-muted) !important;\n}\n\n/* 场景标签 pill */\nhtml.codedrobe-host-workbuddy .wb-scene-tabs__pill {\n  background: var(--cg-glass) !important;\n  border: 1px solid var(--cg-border) !important;\n  border-radius: 999px !important;\n  color: var(--cg-text-muted) !important;\n  box-shadow: var(--cg-edge-light);\n  transition: background-color .15s ease, color .15s ease, box-shadow .15s ease;\n}\n\nhtml.codedrobe-host-workbuddy .wb-scene-tabs__pill:hover {\n  background: rgb(var(--wb-theme-white-rgb) / .78) !important;\n  color: var(--cg-text) !important;\n}\n\nhtml.codedrobe-host-workbuddy .wb-scene-tabs__pill--active,\nhtml.codedrobe-host-workbuddy .wb-scene-tabs__pill[aria-selected='true'] {\n  background: rgb(var(--wb-theme-selection-rgb) / .92) !important;\n  border-color: var(--cg-border-strong) !important;\n  color: var(--cg-brand-deep) !important;\n  box-shadow: var(--cg-edge-light), 0 4px 14px -6px rgb(var(--wb-theme-accent-rgb) / .35);\n}\n\n/* 快捷操作 chip */\nhtml.codedrobe-host-workbuddy .quick-actions__item {\n  background: var(--cg-glass) !important;\n  border: 1px solid var(--cg-border) !important;\n  border-radius: 999px !important;\n  color: var(--cg-text) !important;\n  box-shadow: var(--cg-edge-light);\n  transition: background-color .15s ease, box-shadow .15s ease;\n}\n\nhtml.codedrobe-host-workbuddy .quick-actions__item:hover {\n  background: rgb(var(--wb-theme-white-rgb) / .82) !important;\n  box-shadow: var(--cg-edge-light), var(--cg-shadow-soft);\n}\n\n/* --------------------------------------------------------------------------\n   6. 输入框（首页 + 聊天页共用设计语言）—— 全主题视觉焦点\n   -------------------------------------------------------------------------- */\nhtml.codedrobe-host-workbuddy .wb-home-composer__input-slot > section {\n  position: relative;\n  background: var(--cg-glass-strong) !important;\n  border: 1px solid var(--cg-border-strong) !important;\n  border-radius: var(--cg-radius-lg) !important;\n  box-shadow: var(--cg-edge-light), var(--cg-shadow-panel) !important;\n  color: var(--cg-text) !important;\n  /* 不用 overflow:hidden，避免裁剪模型选择等内嵌下拉；高光带已内缩 */\n  transition: border-color .18s ease, box-shadow .18s ease;\n}\n\n/* 冰晶顶部高光带：一条很淡的蓝色渐变亮边（左右内缩，贴合圆角） */\nhtml.codedrobe-host-workbuddy .wb-home-composer__input-slot > section::before {\n  content: '';\n  position: absolute;\n  inset: 0 14px auto 14px;\n  height: 1px;\n  background: linear-gradient(90deg,\n    transparent 4%, rgb(var(--wb-theme-white-rgb) / .95) 30%,\n    rgb(var(--wb-theme-hero-highlight-rgb) / .9) 50%, rgb(var(--wb-theme-white-rgb) / .95) 70%, transparent 96%);\n  pointer-events: none;\n}\n\n/* 聚焦：品牌蓝描边 + 淡蓝光晕 */\nhtml.codedrobe-host-workbuddy .wb-home-composer__input-slot > section:focus-within {\n  border-color: var(--cg-brand) !important;\n  box-shadow: var(--cg-edge-light), 0 0 0 3px var(--cg-focus-ring), var(--cg-shadow-panel) !important;\n}\n\n/* hover（未聚焦时）轻微提亮描边 */\nhtml.codedrobe-host-workbuddy .wb-home-composer__input-slot > section:hover:not(:focus-within) {\n  border-color: rgb(var(--wb-theme-accent-rgb) / .65) !important;\n}\n\n/* 文本编辑区 */\nhtml.codedrobe-host-workbuddy [role='textbox'][contenteditable='true'] {\n  color: var(--cg-text) !important;\n  caret-color: var(--cg-brand) !important;\n  background: transparent !important;\n}\n\nhtml.codedrobe-host-workbuddy [role='textbox'][contenteditable='true']::selection {\n  background: rgb(var(--wb-theme-accent-rgb) / .22);\n}\n\n/* 输入框内部按钮（附件 / 模型选择 / 工具）：统一浅色图标 + 玻璃 hover */\nhtml.codedrobe-host-workbuddy .wb-home-composer :is([role='combobox'], [role='button'], button) {\n  color: var(--cg-text-muted) !important;\n  border-radius: var(--cg-radius-sm);\n  transition: background-color .15s ease, color .15s ease;\n}\n\nhtml.codedrobe-host-workbuddy .wb-home-composer :is([role='combobox'], [role='button'], button):hover {\n  background: rgb(var(--wb-theme-selection-rgb) / .80) !important;\n  color: var(--cg-brand-deep) !important;\n}\n\n/* 语音入口 */\nhtml.codedrobe-host-workbuddy .voice-mic-trigger {\n  color: var(--cg-text-muted) !important;\n}\n\nhtml.codedrobe-host-workbuddy .voice-mic-wrap:hover .voice-mic-trigger {\n  color: var(--cg-brand-deep) !important;\n}\n\n/* 首页输入框底部 chip 行（wb-input-footer） */\nhtml.codedrobe-host-workbuddy .wb-input-footer button {\n  border: 1px solid var(--cg-border) !important;\n  border-radius: 999px !important;\n  background: rgb(var(--wb-theme-white-rgb) / .55) !important;\n  color: var(--cg-text-muted) !important;\n}\n\nhtml.codedrobe-host-workbuddy .wb-input-footer button:hover {\n  background: rgb(var(--wb-theme-selection-rgb) / .90) !important;\n  color: var(--cg-brand-deep) !important;\n}\n\n/* --------------------------------------------------------------------------\n   7. 消息区域\n   -------------------------------------------------------------------------- */\n/* 用户气泡：浅冰蓝玻璃。id 前缀稳定，bubble 类名为哈希辅助（selector-map §6）。
{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "WorkBuddy 主题切换器",
  "version": "1.6.3",
  "identifier": "com.local.workbuddy-theme-switcher",
  "build": {
    "beforeDevCommand": "npm run vite:dev",
    "beforeBuildCommand": "npm run vite:build",
    "devUrl": "http://127.0.0.1:1432",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "WorkBuddy 主题工作台 1.6.3 候选版",
        "visible": false,
        "width": 1200,
        "height": 820,
        "minWidth": 900,
        "minHeight": 660
      }
    ],
    "security": {
      "csp": "default-src 'none'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' asset: http://asset.localhost data: blob:; font-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost; frame-src 'self' about:; object-src 'none'; base-uri 'none'; form-action 'none'",
      "assetProtocol": {
        "enable": true,
        "scope": [
          "$RESOURCE/themes/**",
          "$LOCALDATA/WorkBuddyThemeSwitcher/custom-themes/**",
          "$LOCALDATA/WorkBuddyThemeSwitcher/studio/**"
        ]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "nsis",
    "publisher": "WorkBuddy Theme Switcher",
    "shortDescription": "本地 WorkBuddy 主题与图片自定义主题切换器",
    "longDescription": "内置主题与图片驱动的自定义主题均可安全应用、验证、自动保持并恢复 WorkBuddy 原版。",
    "resources": {
      "../themes": "themes",
      "../themes.json": "themes.json",
      "../vendor/codedrobe": "codedrobe",
      "../vendor/node": "node"
    },
    "icon": ["icons/icon.ico"],
    "windows": {
      "webviewInstallMode": {
        "type": "embedBootstrapper",
        "silent": true
      }
    }
  }
}
